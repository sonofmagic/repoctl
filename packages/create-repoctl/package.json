{
  "name": "create-repoctl",
  "type": "module",
  "version": "0.1.3",
  "description": "Create a repoctl-managed pnpm and Turborepo workspace",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/repoctl.git",
    "directory": "packages/create-repoctl"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "monorepo",
    "create-app",
    "template",
    "scaffold"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "create-repoctl": "bin/create-repoctl.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "typecheck": "pnpm --filter @icebreakers/monorepo-templates build && node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --files test-d/**/*.test-d.ts",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@icebreakers/monorepo-templates": "workspace:*"
  },
  "devDependencies": {
    "tsd": "^0.33.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
