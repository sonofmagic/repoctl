{
  "name": "@icebreakers/website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation website for repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/repoctl.git",
    "directory": "templates/vitepress"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "documentation",
    "vitepress",
    "monorepo"
  ],
  "scripts": {
    "dev": "vitepress dev",
    "check:locales": "tsx scripts/check-locales.ts",
    "build": "pnpm run check:locales && vitepress build",
    "preview": "vitepress preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "cytoscape": "^3.34.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "mermaid": "^11.17.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.5",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.125.0"
  }
}
